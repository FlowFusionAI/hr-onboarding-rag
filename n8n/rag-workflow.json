    {
      "parameters": {
        "jsCode": "const question = $('Extract Question').first().json.question;\nconst session_id = $('Extract Question').first().json.session_id;\nconst chunks = $input.all().map(item => item.json); // array of 3 chunks\n\nconst contextText = chunks\n  .map((c, i) => `[${i + 1}] Source: ${c.source_file} — ${c.section}\\n${c.content}`)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    session_id,\n    chunks: chunks.map(c => c.content), // saved for sources in the final response\n    chatInput: `QUESTION: ${question}\\n\\n\\nRETRIEVED CONTEXT:\\n${contextText}`\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        800
      ],
      "id": "c47ae07f-0e24-41e4-932c-6e84003f25ae",
      "name": "Build Context"
    },
    {
      "parameters": {
        "jsCode": "const answer = $input.first().json.output;\nconst chunks = $('Build Context').first().json.chunks;\nconst session_id = $('Build Context').first().json.session_Id;\n\nreturn [{\n  json: {\n    answer,\n    sources: chunks,\n    session_id\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        800
      ],
      "id": "006ccfa7-f6cb-4d05-bb75-746decb83b11",
      "name": "Format Response"
    },
    {
      "parameters": {
        "jsCode": "const embedding = $input.first().json.data[0].embedding;\nconst session_id = $('Extract Question').first().json.session_id;\nconst question = $('Extract Question').first().json.question;\n\nreturn [{\n  json: {\n    query_embedding: '[' + embedding.join(',') + ']',\n    match_count: 3,\n    session_id,\n    question\n  }\n}];\n"
      },
